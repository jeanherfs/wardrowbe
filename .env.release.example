# ./wardrobe release generates .env.release from this template.
POSTGRES_USER=wardrobe
POSTGRES_PASSWORD=replace-with-a-generated-value
POSTGRES_DB=wardrobe
SECRET_KEY=replace-with-a-generated-value
NEXTAUTH_SECRET=replace-with-a-generated-value
LOCAL_AUTH_ENABLED=true
LOCAL_AUTH_BOOTSTRAP_TOKEN=replace-with-a-generated-value
AI_INTERNAL_ENABLED=false
NEXTAUTH_URL=http://localhost:8080
