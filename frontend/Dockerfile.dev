FROM node:24-alpine

WORKDIR /app

# Copy package files first for better caching
COPY package.json package-lock.json* ./

# Install the lockfile's exact dependency graph
RUN npm ci

# The rest will be mounted as volume
# But we need node_modules to persist, so we use a named volume

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Reset the persisted dependency volume so partial installs cannot survive restarts
CMD npm ci && npm run dev
