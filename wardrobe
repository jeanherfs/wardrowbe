#!/usr/bin/env bash

set -Eeuo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
compose_files=(-f docker-compose.yml -f docker-compose.dev.yml)
release_env="${WARDROBE_RELEASE_ENV:-$repo_root/.env.release}"

if command -v luma >/dev/null 2>&1; then
  eval "$(luma env)"
  say_heading() { luma_heading "$1"; }
  say_ok() { luma_ok "$1"; }
  say_step() { luma_step "$1"; }
  say_note() { luma_note "$1"; }
  say_warn() { luma_warn "$1"; }
  say_die() { luma_die "$1"; }
else
  say_heading() { printf '\n%s\n' "$1"; }
  say_ok() { printf 'ok: %s\n' "$1"; }
  say_step() { printf '-> %s\n' "$1"; }
  say_note() { printf '   %s\n' "$1"; }
  say_warn() { printf 'warning: %s\n' "$1" >&2; }
  say_die() { printf 'error: %s\n' "$1" >&2; exit 1; }
fi

usage() {
  cat <<'EOF'
Usage: ./wardrobe <command>

Commands:
  setup                 install or start Docker when the host supports it
  up [--no-build]       build, start, and migrate the local development stack
  down                  stop the local stack
  status                show service status
  logs [service...]     follow service logs
  migrate               apply database migrations
  import --user-id ID --manifest FILE --image-root DIRECTORY
                        import a retailer manifest and downloaded product images
  help                  show this help
EOF
}

release_usage() {
  cat <<'EOF'
Usage: ./wardrobe release <command>

Commands:
  up [--email EMAIL] [--display-name NAME] [--password PASSWORD]
                        build, start, migrate, and optionally bootstrap release
  setup                 install or start Docker and prepare release secrets
  down                  stop the release stack
  status                show release service status
  logs [service...]     follow release service logs
  migrate               apply release database migrations
  bootstrap --email EMAIL
                        create the local account and print a temporary password
  import --user-id ID --manifest FILE --image-root DIRECTORY
                        import a retailer manifest into the release database
  backup DIRECTORY      create portable database and upload backups
  restore DIRECTORY     restore a release backup into the stopped stack
  help                  show this help
EOF
}

compose() {
  docker compose "${compose_files[@]}" "$@"
}

release_compose() {
  docker compose --env-file "$release_env" -f docker-compose.release.yml "$@"
}

release_random_secret() {
  openssl rand -hex 32
}

release_ensure_env() {
  if [[ ! -f "$release_env" ]]; then
    say_step "creating release secrets"
    umask 077
    {
      printf 'POSTGRES_USER=wardrobe\n'
      printf 'POSTGRES_PASSWORD=%s\n' "$(release_random_secret)"
      printf 'POSTGRES_DB=wardrobe\n'
      printf 'SECRET_KEY=%s\n' "$(release_random_secret)"
      printf 'NEXTAUTH_SECRET=%s\n' "$(release_random_secret)"
      printf 'LOCAL_AUTH_ENABLED=true\n'
      printf 'LOCAL_AUTH_BOOTSTRAP_TOKEN=%s\n' "$(release_random_secret)"
      printf 'AI_INTERNAL_ENABLED=false\n'
      printf 'NEXTAUTH_URL=http://localhost:8080\n'
    } > "$release_env"
    chmod 600 "$release_env"
  fi
  [[ "$(stat -f '%Lp' "$release_env" 2>/dev/null || stat -c '%a' "$release_env")" == "600" ]] || chmod 600 "$release_env"
}

release_migrations() {
  say_step "applying release database migrations"
  release_compose exec -T backend alembic upgrade head
}

release_wait() {
  for _ in {1..30}; do
    if release_compose exec -T backend curl --fail --silent http://localhost:8000/api/v1/health >/dev/null 2>&1 \
      && curl --fail --silent http://localhost:8080 >/dev/null 2>&1; then
      return
    fi
    sleep 2
  done
  say_warn "the release stack is still starting; inspect it with ./wardrobe release logs"
}

release_bootstrap() {
  local email=""
  local display_name=""
  local password=""
  local reset=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --email) email="${2:-}"; shift 2 ;;
      --display-name) display_name="${2:-}"; shift 2 ;;
      --password) password="${2:-}"; shift 2 ;;
      --reset-password) reset=true; shift ;;
      *) say_die "unknown bootstrap option: $1" ;;
    esac
  done
  [[ -n "$email" ]] || say_die "bootstrap requires --email EMAIL"
  [[ -n "$display_name" ]] || display_name="${email%@*}"

  local args=(--email "$email" --display-name "$display_name")
  [[ -n "$password" ]] && args+=(--password "$password")
  [[ "$reset" == true ]] && args+=(--reset-password)
  release_compose exec -T backend python scripts/bootstrap_local_user.py "${args[@]}"
}

release_start() {
  local build=true
  local bootstrap_args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --no-build) build=false; shift ;;
      --email|--display-name|--password) bootstrap_args+=("$1" "${2:-}"); shift 2 ;;
      --reset-password) bootstrap_args+=("$1"); shift ;;
      *) say_die "unknown release up option: $1" ;;
    esac
  done

  ensure_docker
  release_ensure_env
  say_heading "Wardrowbe release"
  if [[ "$build" == true ]]; then
    say_step "building release images"
    release_compose build
  fi
  say_step "starting release services"
  release_compose up -d
  release_migrations
  if [[ "${#bootstrap_args[@]}" -gt 0 ]]; then
    release_bootstrap "${bootstrap_args[@]}"
  fi
  release_wait
  say_ok "Wardrowbe release is available at http://localhost:8080"
}

release_import_manifest() {
  ensure_docker
  release_ensure_env
  [[ "${1:-}" == "--user-id" && -n "${2:-}" ]] || say_die "release import requires --user-id ID"
  local user_id="$2"
  shift 2
  [[ "${1:-}" == "--manifest" && -f "${2:-}" ]] || say_die "release import requires --manifest FILE"
  local manifest="$(cd "$(dirname "$2")" && pwd)/$(basename "$2")"
  shift 2
  [[ "${1:-}" == "--image-root" && -d "${2:-}" ]] || say_die "release import requires --image-root DIRECTORY"
  local image_root="$(cd "$2" && pwd)"
  shift 2
  [[ $# -eq 0 ]] || say_die "unknown release import option: $1"

  release_migrations
  say_step "importing retailer items into release"
  release_compose run --rm --no-deps \
    -v "$(dirname "$manifest"):/imports/manifest:ro" \
    -v "$image_root:/imports/images:ro" \
    backend python scripts/import_retailer_manifest.py \
    --user-id "$user_id" \
    --manifest "/imports/manifest/$(basename "$manifest")" \
    --image-root /imports/images
}

release_env_value() {
  local key="$1"
  awk -F= -v key="$key" '$1 == key {sub(/^[^=]*=/, ""); print; exit}' "$release_env"
}

release_wait_for_postgres() {
  local db_user
  db_user="$(release_env_value POSTGRES_USER)"
  for _ in {1..30}; do
    if release_compose exec -T postgres pg_isready -U "$db_user" >/dev/null 2>&1; then
      return
    fi
    sleep 2
  done
  say_die "the release database did not become ready"
}

release_backup() {
  local backup_dir="${1:-}"
  [[ -n "$backup_dir" && $# -eq 1 ]] || say_die "backup requires exactly one directory"
  ensure_docker
  release_ensure_env
  mkdir -p "$backup_dir"
  local db_user db_name
  db_user="$(release_env_value POSTGRES_USER)"
  db_name="$(release_env_value POSTGRES_DB)"
  release_compose up -d postgres >/dev/null
  release_wait_for_postgres
  say_step "exporting release database"
  release_compose exec -T postgres pg_dump -U "$db_user" -d "$db_name" --format=custom > "$backup_dir/wardrowbe.dump"
  say_step "exporting release uploads"
  docker run --rm -v wardrobe_release_uploads:/data -v "$(cd "$backup_dir" && pwd):/backup" alpine \
    tar -czf /backup/uploads.tar.gz -C /data .
  awk -F= '{
    key=$1
    if (key ~ /PASSWORD|SECRET|TOKEN|KEY/) print key "=REDACTED"
    else print $0
  }' "$release_env" > "$backup_dir/release.env.example"
  chmod 600 "$backup_dir/wardrowbe.dump" "$backup_dir/uploads.tar.gz" "$backup_dir/release.env.example"
  say_ok "release backup written to $backup_dir"
}

release_restore() {
  local backup_dir="${1:-}"
  local force=false
  if [[ "$backup_dir" == "--force-empty-target" ]]; then
    force=true
    backup_dir="${2:-}"
    shift
  fi
  [[ -n "$backup_dir" && $# -le 1 ]] || say_die "restore requires DIRECTORY, optionally preceded by --force-empty-target"
  [[ -f "$backup_dir/wardrowbe.dump" && -f "$backup_dir/uploads.tar.gz" ]] || say_die "restore requires wardrowbe.dump and uploads.tar.gz"
  ensure_docker
  release_ensure_env
  local db_user db_name table_count
  db_user="$(release_env_value POSTGRES_USER)"
  db_name="$(release_env_value POSTGRES_DB)"
  release_compose up -d postgres >/dev/null
  release_wait_for_postgres
  table_count="$(release_compose exec -T postgres psql -U "$db_user" -d "$db_name" -Atc \
    "SELECT COUNT(*) FROM pg_tables WHERE schemaname = 'public'")"
  if [[ "$table_count" != "0" && "$force" != true ]]; then
    say_die "release database is not empty; pass --force-empty-target to restore"
  fi
  release_compose stop frontend backend worker >/dev/null 2>&1 || true
  say_step "restoring release database"
  release_compose exec -T postgres pg_restore --clean --if-exists --no-owner --exit-on-error \
    -U "$db_user" -d "$db_name" < "$backup_dir/wardrowbe.dump"
  say_step "restoring release uploads"
  if [[ "$force" == true ]]; then
    docker run --rm -v wardrobe_release_uploads:/data -v "$(cd "$backup_dir" && pwd):/backup" alpine \
      sh -c 'find /data -mindepth 1 -maxdepth 1 -exec rm -rf -- {} + && tar -xzf /backup/uploads.tar.gz -C /data'
  else
    docker run --rm -v wardrobe_release_uploads:/data -v "$(cd "$backup_dir" && pwd):/backup" alpine \
      tar -xzf /backup/uploads.tar.gz -C /data
  fi
  release_compose up -d
  release_migrations
  say_ok "release backup restored from $backup_dir"
}

install_docker() {
  case "$(uname -s)" in
    Darwin)
      command -v brew >/dev/null 2>&1 || say_die "Docker Desktop is required; install Homebrew first or install Docker Desktop manually"
      say_step "installing Docker Desktop"
      brew install --cask docker
      open -a Docker
      ;;
    Linux)
      command -v apt-get >/dev/null 2>&1 || say_die "install Docker Engine and the Docker Compose plugin, then rerun ./wardrobe setup"
      say_step "installing Docker Engine and Docker Compose"
      sudo apt-get update
      sudo apt-get install -y docker.io docker-compose-plugin
      sudo systemctl enable --now docker
      ;;
    *)
      say_die "install Docker and Docker Compose for this operating system, then rerun ./wardrobe setup"
      ;;
  esac
}

ensure_docker() {
  if ! command -v docker >/dev/null 2>&1; then
    install_docker
  fi

  if ! docker info >/dev/null 2>&1; then
    case "$(uname -s)" in
      Darwin)
        say_step "starting Docker Desktop"
        open -a Docker
        ;;
      Linux)
        say_die "Docker is installed but not running; start the Docker service, then rerun this command"
        ;;
    esac

    for _ in {1..30}; do
      if docker info >/dev/null 2>&1; then
        break
      fi
      sleep 2
    done
  fi

  docker info >/dev/null 2>&1 || say_die "Docker did not become ready"
  docker compose version >/dev/null 2>&1 || say_die "Docker Compose v2 is required"
}

wait_for_service() {
  local url="$1"
  local service="$2"
  for _ in {1..30}; do
    if curl --fail --silent --show-error "$url" >/dev/null 2>&1; then
      return
    fi
    sleep 2
  done
  say_warn "the $service is still starting; inspect it with ./wardrobe logs $service"
}

run_migrations() {
  say_step "applying database migrations"
  compose exec -T backend alembic upgrade head
}

import_manifest() {
  ensure_docker
  [[ "${1:-}" == "--user-id" && -n "${2:-}" ]] || say_die "import requires --user-id ID"
  local user_id="$2"
  shift 2
  [[ "${1:-}" == "--manifest" && -f "${2:-}" ]] || say_die "import requires --manifest FILE"
  local manifest="$(cd "$(dirname "$2")" && pwd)/$(basename "$2")"
  shift 2
  [[ "${1:-}" == "--image-root" && -d "${2:-}" ]] || say_die "import requires --image-root DIRECTORY"
  local image_root="$(cd "$2" && pwd)"
  shift 2
  [[ $# -eq 0 ]] || say_die "unknown import option: $1"

  run_migrations
  say_step "importing retailer items"
  compose run --rm --no-deps \
    -v "$(dirname "$manifest"):/imports/manifest:ro" \
    -v "$image_root:/imports/images:ro" \
    backend python scripts/import_retailer_manifest.py \
    --user-id "$user_id" \
    --manifest "/imports/manifest/$(basename "$manifest")" \
    --image-root /imports/images
}

start() {
  local build=true
  if [[ "${1:-}" == "--no-build" ]]; then
    build=false
  elif [[ $# -gt 0 ]]; then
    say_die "unknown up option: $1"
  fi

  ensure_docker
  say_heading "Wardrowbe"
  if [[ "$build" == true ]]; then
    say_step "building application dependencies"
    compose build
  fi
  say_step "starting local services"
  compose up -d
  run_migrations
  wait_for_service http://localhost:8000/api/v1/health backend
  wait_for_service http://localhost:3000 frontend
  say_ok "Wardrowbe is available at http://localhost:3000"
}

cd "$repo_root"
command="${1:-help}"
if [[ $# -gt 0 ]]; then
  shift
fi

case "$command" in
  help|--help|-h) usage ;;
  release)
    release_command="${1:-help}"
    if [[ $# -gt 0 ]]; then shift; fi
    case "$release_command" in
      help|--help|-h) release_usage ;;
      setup) ensure_docker; release_ensure_env; say_ok "release prerequisites are ready" ;;
      up) release_start "$@" ;;
      down) ensure_docker; release_ensure_env; release_compose down ;;
      status) ensure_docker; release_ensure_env; release_compose ps ;;
      logs) ensure_docker; release_ensure_env; release_compose logs -f "$@" ;;
      migrate) ensure_docker; release_ensure_env; release_migrations ;;
      bootstrap) ensure_docker; release_ensure_env; release_bootstrap "$@" ;;
      import) release_import_manifest "$@" ;;
      backup) release_backup "$@" ;;
      restore) release_restore "$@" ;;
      *) say_die "unknown release command: $release_command" ;;
    esac
    ;;
  setup) ensure_docker; say_ok "Docker is ready" ;;
  up) start "$@" ;;
  down) ensure_docker; compose down ;;
  status) ensure_docker; compose ps ;;
  logs) ensure_docker; compose logs -f "$@" ;;
  migrate) ensure_docker; run_migrations ;;
  import) import_manifest "$@" ;;
  *) say_die "unknown command: $command" ;;
esac
